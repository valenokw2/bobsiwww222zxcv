<Page x:Class="PixelOverlay.Views.OverlayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:toolkit="using:Microsoft.Toolkit.Uwp.UI.Controls"
      Background="#00000000">
    <!-- Named Transparent can paint black inside Game Bar. #00000000 stays clear. -->
    <Grid x:Name="OverlaySurface" Background="#00000000" SizeChanged="OverlaySurface_SizeChanged">
        <toolkit:ImageEx x:Name="OverlayImage"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Stretch="Uniform"
               IsHitTestVisible="False">
            <Image.RenderTransform>
                <CompositeTransform x:Name="OverlayTransform" />
            </Image.RenderTransform>
        </toolkit:ImageEx>
        <TextBlock x:Name="Hint" Text="Open this widget's settings to import an image"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Foreground="#B4FFFFFF" FontSize="13" TextWrapping="Wrap" Margin="16"
                   IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
</Page>
