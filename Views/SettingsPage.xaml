<Page x:Class="PixelOverlay.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:toolkit="using:Microsoft.Toolkit.Uwp.UI.Controls"
      Background="Transparent"
      AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop">
    <Grid Background="{StaticResource PanelBrush}">
        <muxc:NavigationView x:Name="RootNavigation"
                             PaneDisplayMode="LeftCompact"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             CompactPaneLength="52"
                             OpenPaneLength="180"
                             SelectionChanged="NavigationView_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Windows" Tag="windows">
                    <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="ViewAll"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Library" Tag="library">
                    <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="Pictures"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Overlay" Tag="overlay">
                    <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="Edit"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Media search" Tag="media">
                    <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="Find"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Grid Padding="14">
                <!-- 1. Per-window controls -->
                <Grid x:Name="WindowsSection" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <StackPanel>
                                <TextBlock Text="WINDOWS" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="Up to 32 independently configured overlay slots" FontSize="11" Opacity=".7"/>
                            </StackPanel>
                            <TextBlock Text="Selected slot" FontWeight="SemiBold"/>
                            <ComboBox x:Name="WindowSlotSelector" HorizontalAlignment="Stretch"
                                      SelectionChanged="WindowSlotSelector_SelectionChanged"/>
                            <TextBlock x:Name="WindowSummaryText" Text="No image selected" TextWrapping="Wrap" Opacity=".75"/>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Content="New" Click="CreateWindow_Click"/>
                                <Button Grid.Column="1" Content="Clone" Click="CloneWindow_Click"/>
                                <Button Grid.Column="2" Content="Delete" Click="DeleteWindow_Click"/>
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Content="Open selected overlay" Click="OpenWindow_Click"/>
                                <Button Grid.Column="1" Content="Close selected" Click="CloseWindow_Click"/>
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button x:Name="HideOverlayButton" Content="Hide" Click="HideOverlay_Click"/>
                                <Button x:Name="ShowOverlayButton" Grid.Column="1" Content="Show" Click="ShowOverlay_Click"/>
                            </Grid>
                            <Border Background="#251C2430" Padding="10" CornerRadius="6">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Game Bar host state" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ClickThroughStatusText" Text="Click-through state unavailable" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="WindowVisibilityStatusText" Text="Visibility: visible" FontSize="12"/>
                                    <TextBlock Text="Click-through is controlled by the Game Bar widget host. This panel reports the settings widget's current host state; it does not silently change another widget's input mode."
                                               FontSize="10" Opacity=".65" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Each slot has its own image, transform, opacity, GIF speed, favorites and hidden state. Image files are shared in one library." FontSize="11" Opacity=".65" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 2. Shared library and per-window favorites -->
                <Grid x:Name="LibrarySection" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Text="LIBRARY &amp; FAVORITES" FontSize="18" FontWeight="SemiBold"/>
                        <TextBox x:Name="LibrarySearchBox" PlaceholderText="Search image names"
                                 TextChanged="LibrarySearch_TextChanged"/>
                        <ComboBox x:Name="LibraryFilterSelector" SelectedIndex="0"
                                  SelectionChanged="LibraryFilter_SelectionChanged">
                            <ComboBoxItem Content="All images" Tag="all"/>
                            <ComboBoxItem Content="Favorites for this window" Tag="favorites"/>
                            <ComboBoxItem Content="GIF only" Tag="gif"/>
                            <ComboBoxItem Content="Current window image" Tag="current"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="LibraryCountText" Grid.Row="1" Text="0 images" FontSize="11" Opacity=".65" Margin="0,8,0,4"/>
                    <ListView x:Name="LibraryList" Grid.Row="2" SelectionChanged="Library_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Extension}" FontSize="10" Opacity=".6"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="☆" Tag="{Binding}" Click="ToggleFavorite_Click"/>
                                    <Button Grid.Column="2" Content="Remove" Tag="{Binding}" Click="RemoveImage_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="3" ColumnSpacing="6" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="Import image" Click="Import_Click"/>
                        <Button Grid.Column="1" Content="Use in selected window" Click="ApplyLibrarySelection_Click"/>
                    </Grid>
                </Grid>

                <!-- 3. Overlay tuning -->
                <Grid x:Name="OverlaySection" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="OVERLAY &amp; TWEAKS" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="OverlayWindowLabel" Text="Editing overlay-01" FontSize="11" Opacity=".7"/>
                    </StackPanel>
                    <Border Grid.Row="1" x:Name="PreviewSurface" Background="#12151C" CornerRadius="6"
                            SizeChanged="PreviewSurface_SizeChanged"
                            PointerPressed="Preview_PointerPressed" PointerMoved="Preview_PointerMoved"
                            PointerReleased="Preview_PointerReleased"
                            PointerCaptureLost="Preview_PointerCaptureLost" PointerCanceled="Preview_PointerCanceled">
                        <Grid>
                            <TextBlock x:Name="EmptyPreview" Text="PNG, JPG, JPEG, WEBP or GIF&#10;Drop here or import an image"
                                       TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity=".55"/>
                            <toolkit:ImageEx x:Name="PreviewImage" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                             Stretch="Uniform" DecodePixelWidth="1920" IsHitTestVisible="False">
                                <toolkit:ImageEx.RenderTransform>
                                    <CompositeTransform x:Name="PreviewTransform"/>
                                </toolkit:ImageEx.RenderTransform>
                            </toolkit:ImageEx>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="9" Padding="0,8,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="Opacity"/><TextBlock Grid.Column="1" Text="{Binding OpacityText}" HorizontalAlignment="Right" Opacity=".7"/></Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Opacity, Mode=TwoWay}"/>
                            <CheckBox Content="Ignore Game Bar opacity" IsChecked="{Binding IgnoreGameBarOpacity, Mode=TwoWay}"/>
                            <CheckBox Content="Enable Ctrl+Alt+O hide/show hotkey" IsChecked="{Binding VisibilityHotkeyEnabled, Mode=TwoWay}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="Scale"/><TextBlock Grid.Column="1" Text="{Binding ScaleText}" HorizontalAlignment="Right" Opacity=".7"/></Grid>
                            <Slider Minimum="10" Maximum="500" Value="{Binding Scale, Mode=TwoWay}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="Rotation"/><TextBlock Grid.Column="1" Text="{Binding RotationText}" HorizontalAlignment="Right" Opacity=".7"/></Grid>
                            <Slider Minimum="0" Maximum="360" Value="{Binding Rotation, Mode=TwoWay}"/>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Content="Center" Click="Center_Click"/>
                                <Button Grid.Column="1" Content="Reset all" Click="Reset_Click"/>
                                <Button Grid.Column="2" Content="Reset rotation" Click="ResetRotation_Click"/>
                            </Grid>
                            <TextBlock Text="Position (drag preview or enter coordinates)" FontSize="11" Opacity=".75"/>
                            <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBox x:Name="PositionXBox" Header="X" Text="{Binding PositionX, Mode=TwoWay}"/>
                                <TextBox x:Name="PositionYBox" Grid.Column="1" Header="Y" Text="{Binding PositionY, Mode=TwoWay}"/>
                            </Grid>
                            <StackPanel x:Name="GifControls" Spacing="5">
                                <TextBlock Text="GIF playback"/>
                                <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <Slider Minimum=".25" Maximum="4" StepFrequency=".25" Value="{Binding GifSpeed, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GifSpeedText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                                <Button x:Name="PlayPauseButton" Content="Pause GIF" Click="PlayPause_Click"/>
                            </StackPanel>
                            <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Content="Save preset" Click="SavePreset_Click"/>
                                <TextBox Grid.Column="1" x:Name="ProfileNameBox" PlaceholderText="Preset name"/>
                            </Grid>
                            <ListView x:Name="ProfileList">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="Apply" Tag="{Binding}" Click="ApplyPreset_Click"/>
                                            <Button Grid.Column="2" Content="Delete" Tag="{Binding}" Click="RemovePreset_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 4. External media and direct imports -->
                <Grid x:Name="MediaSection" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="9">
                            <TextBlock Text="MEDIA SEARCH" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="GIPHY search and trending use the official REST API. Results remain provider-hosted and are not copied or cached by Pixel Overlay." FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                            <TextBox x:Name="GiphyApiKeyBox" Header="GIPHY API key" PlaceholderText="Enter your public API key" />
                            <Button Content="Save API key" Click="SaveGiphyKey_Click"/>
                            <TextBox x:Name="GiphyQueryBox" Header="Search GIFs" PlaceholderText="Search phrase"/>
                            <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Content="Search" Click="GiphySearch_Click"/>
                                <Button Grid.Column="1" Content="Trending" Click="GiphyTrending_Click"/>
                            </Grid>
                            <TextBlock Text="Powered by GIPHY" FontWeight="SemiBold" FontSize="11"/>
                            <ListView x:Name="GiphyResultsList" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2" Padding="3">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                            <HyperlinkButton Content="Open on GIPHY" Tag="{Binding}" Click="OpenMediaResult_Click" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Rectangle Height="1" Fill="#40FFFFFF"/>
                            <TextBlock Text="Direct image import" FontWeight="SemiBold"/>
                            <TextBlock Text="Paste an HTTPS URL that returns an image file (not a Pinterest/GIPHY page). Downloads are capped at 32 MiB and checked against MIME type and file signature before saving locally." FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                            <TextBox x:Name="ImageUrlBox" Header="Direct image URL" PlaceholderText="https://…/image.gif"/>
                            <Button Content="Download to library" Click="ImportUrl_Click"/>
                            <TextBlock Text="Pinterest boards" FontWeight="SemiBold"/>
                            <TextBlock Text="Direct image links from Pinterest CDN can be imported above. OAuth board sync is not enabled: the authorization-code exchange requires a server-side client secret and a secure backend endpoint." FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Page>