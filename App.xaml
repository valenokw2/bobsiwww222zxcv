<Application x:Class="PixelOverlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#E6151820" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6EA8FE" />
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI" /></Style>
    </Application.Resources>
</Application>
